{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "lib/test",
        "lib/**/*.test.js",
        "lib/**/*.test.js.map",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint:check",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
